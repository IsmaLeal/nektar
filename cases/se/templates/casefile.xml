<?xml version="1.0" encoding="utf-8"?>
<!-- Deterministic NS sampling run. Placeholders @RE@, @DT@, @T_END@,
     @CHK_STEPS@, @INFO_STEPS@ are substituted by run_bifurcation.sh. -->
<NEKTAR>
  <EXPANSIONS>
    <E COMPOSITE="C[12]" NUMMODES="7" FIELDS="u,v,p" TYPE="MODIFIED" />
  </EXPANSIONS>

  <CONDITIONS>
    <PARAMETERS>
      <P> TimeStep      = 0.1 </P>
      <P> FinTime       = 80.0 </P>
      <P> NumSteps      = FinTime / TimeStep </P>
      <P> IO_InfoSteps  = 100 </P>
      <P> IO_CFLSteps   = 100 </P>
      <P> Re            = 50 </P>
      <P> Kinvis        = 1.0 / Re </P>
    </PARAMETERS>
    <SOLVERINFO>
      <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme"/>
      <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes"/>
      <I PROPERTY="Projection" VALUE="Continuous"/>
      <I PROPERTY="SPECTRALHPDEALIASING" VALUE="True"/>
    </SOLVERINFO>
    <TIMEINTEGRATIONSCHEME>
      <METHOD> IMEX </METHOD>
      <ORDER> 2 </ORDER>
    </TIMEINTEGRATIONSCHEME>
    <VARIABLES>
      <V ID="0"> u </V>
      <V ID="1"> v </V>
      <V ID="2"> p </V>
    </VARIABLES>
    <BOUNDARYREGIONS>
      <B ID="0">C[9]</B>  <!-- Inlet  -->
      <B ID="1">C[11]</B> <!-- Outlet -->
      <B ID="2">C[10]</B> <!-- Walls  -->
    </BOUNDARYREGIONS>
    <BOUNDARYCONDITIONS>
      <REGION REF="0">
        <D VAR="u" VALUE="(3/2)*(1-4*y*y)"/>
        <D VAR="v" VALUE="0"/>
        <N VAR="p" VALUE="0"/>
      </REGION>
      <REGION REF="1">
        <N VAR="u" VALUE="0.0"/>
        <N VAR="v" VALUE="0.0"/>
        <D VAR="p" VALUE="0.0"/>
      </REGION>
      <REGION REF="2">
        <D VAR="u" VALUE="0.0"/>
        <D VAR="v" VALUE="0.0"/>
        <N VAR="p" VALUE="0.0"/>
      </REGION>
    </BOUNDARYCONDITIONS>
    <FUNCTION NAME="InitialConditions">
      <E VAR="v,p" VALUE="0.0"/>
      <E VAR="u" VALUE="1.0"/>
    </FUNCTION>
  </CONDITIONS>
  <FILTERS>
    <FILTER TYPE="Checkpoint">
      <PARAM NAME="OutputFile">output/casefile</PARAM>
      <PARAM NAME="OutputFrequency">100</PARAM>
    </FILTER>
  </FILTERS>
</NEKTAR>
