<?xml version="1.0" encoding="utf-8"?> <!-- Not necessary but nice -->
<NEKTAR>
  <EXPANSIONS>
    <E COMPOSITE="C[10]" NUMMODES="12" FIELDS="u,v,p" TYPE="MODIFIED" />
  </EXPANSIONS>

  <CONDITIONS>
    <PARAMETERS>
      <!-- <P> NumSteps = 1000 </P> -->
      <P> TimeStep = 0.01 </P>
      <!-- <P> FinTime = NumSteps*TimeStep </P> -->
      <P> FinTime = 20.0 </P>
      <P> IO_InfoSteps = 100 </P>
      <P> IO_CFLSteps = 100 </P>
      <P> Re = 10 </P>
      <P> Kinvis = 1.0 / Re </P>
    </PARAMETERS>
    <SOLVERINFO>
      <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme"/>
      <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes"/>
      <I PROPERTY="Projection" VALUE="Continuous"/>
      <I PROPERTY="SPECTRALHPDEALIASING" VALUE="True"/>
    </SOLVERINFO>
    <TIMEINTEGRATIONSCHEME>
      <METHOD> IMEX </METHOD>
      <ORDER> 2 </ORDER>
    </TIMEINTEGRATIONSCHEME>
    <VARIABLES>
      <V ID="0"> u </V>
      <V ID="1"> v </V>
      <V ID="2"> p </V>
    </VARIABLES>
    <BOUNDARYREGIONS>
      <B ID="0">C[7]</B> <!-- Inlet -->
      <B ID="1">C[8]</B> <!-- Outlet -->
      <B ID="2">C[6]</B> <!-- Top/Bottom walls -->
      <B ID="3">C[9]</B> <!-- Cylinder -->
    </BOUNDARYREGIONS>
    <BOUNDARYCONDITIONS>
      <REGION REF="0"> <!-- Inlet -->
        <D VAR="u" VALUE="1"/>
        <D VAR="v" VALUE="0"/>
        <N VAR="p" VALUE="0" USERDEFINEDTYPE="H"/>
      </REGION>
      <REGION REF="1"> <!-- Outlet -->
        <N VAR="u" VALUE="0.0"/>
        <N VAR="v" VALUE="0.0"/>
        <D VAR="p" VALUE="0.0"/>
      </REGION>
      <REGION REF="2"> <!-- Top/bottom walls -->
        <D VAR="u" VALUE="1.0"/>
        <D VAR="v" VALUE="0.0"/>
        <N VAR="p" VALUE="0.0" USERDEFINEDTYPE="H"/>
      </REGION>
      <REGION REF="3"> <!-- Cylinder -->
        <D VAR="u" VALUE="0.0"/>
        <D VAR="v" VALUE="0.0"/>
        <N VAR="p" VALUE="0.0" USERDEFINEDTYPE="H"/>
      </REGION>
    </BOUNDARYCONDITIONS>
    <FUNCTION NAME="InitialConditions">
      <E VAR="v,p" VALUE="0.0"/>
      <E VAR="u" VALUE="1.0"/>
    </FUNCTION>
  </CONDITIONS>
  <FILTERS>
    <FILTER TYPE="Checkpoint">
      <PARAM NAME="OutputFile">output/casefile</PARAM>
      <PARAM NAME="OutputFrequency">50</PARAM>
    </FILTER>
  </FILTERS>
</NEKTAR>
