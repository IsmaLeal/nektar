.*
!.gitignore
!.gitlab-ci.yml
!.gitattributes
!.clang-format
!.clang-tidy
!.dockerignore
!.gitlab-ci
# Ignore builds, ThirdParty and Testing directories
build*
ThirdParty
Testing
# Ignore .DS_Store sometimes created by OS X.
.DS_Store
# for the userguide
*.pdf
# Kdevelop project files
*.kdev4
# Sublime project files
*.sublime-project
*.sublime-workspace
# CLion build directories
cmake-build-*
# Any python cache directories
__pycache__
# Generated CardiacEPSolver CellModel class
solvers/CardiacEPSolver/CellModels/CellMLTest.*
# Generated source files
library/MatrixFreeOps/SwitchLimits.h

# Solver run outputs (keep small, intentional inputs tracked explicitly)
*.fld
*.chk
*.his
*.rst
*.vtu
*.plt
*.dat
cases/**/output*/
solvers/**/Tests/output*/

# Per-run outputs and large intermediates inside cases/ — only sources
# (XMLs, meshes, scripts) should be committed; results are regenerable.
cases/**/runs/
cases/**/snapshots/
cases/**/samples/
cases/**/samples_generic/
cases/**/*.do_archive
cases/**/*.bak*
cases/**/*.log
cases/**/*.pvd
cases/**/*.csv
cases/**/geometry_xml/
cases/**/casefile_xml/
cases/**/mesh/geometry_*.chk
cases/**/mesh/casefile_*.chk

# Top-level run outputs
runs/
